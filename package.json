{
  "name": "voice-agent-platform",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:architecture && pnpm check:file-size",
    "db:migrate:staging": "pnpm --filter @voice-agent/database run db:migrate:staging",
    "test:staging:db": "node --env-file=.env.staging ./node_modules/vitest/vitest.mjs run packages/database/src/staging-connection.test.ts packages/database/src/staging-domain-integrity.test.ts",
    "test:staging:web": "node --env-file=.env.staging ./node_modules/vitest/vitest.mjs run apps/web/src/lib/auth/auth.staging.test.ts",
    "test:staging": "pnpm test:staging:db && pnpm test:staging:web"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^17.12.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  }
}
