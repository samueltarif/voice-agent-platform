# ==============================================================================
# Environment Configuration Template — STAGING (Placeholders Only - Zero Secrets)
# ==============================================================================
# To use: copy this file to .env.staging and fill with staging credentials.
# .env.staging is untracked and gitignored. NEVER commit real secrets.

APP_ENV=staging
STAGING_SMOKE_TESTS=false

# Runtime Database Connection (Neon Pooled endpoint with -pooler and sslmode=require)
DATABASE_URL=

# Migration Database Connection (Neon Direct endpoint without -pooler and sslmode=require)
# MANDATORY for staging migrations (fails closed if missing)
MIGRATION_DATABASE_URL=

# Better Auth Configuration (Staging)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
