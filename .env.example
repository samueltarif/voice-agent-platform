# ==============================================================================
# Environment Configuration Template (Placeholders Only - Zero Secrets in Git)
# ==============================================================================

# Database Connectivity (PostgreSQL 16)
# Local Docker Compose defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agent_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agent_test
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_agent_dev

# Better Auth Configuration (apps/web)
BETTER_AUTH_SECRET=development-insecure-secret-minimum-32-characters-required!
BETTER_AUTH_URL=http://localhost:3000
