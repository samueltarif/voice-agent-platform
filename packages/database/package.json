{
  "name": "@voice-agent/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:staging": "node --env-file=../../.env.staging ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:staging": "node --env-file=../../.env.staging ../../node_modules/vitest/vitest.mjs run src/staging-connection.test.ts src/staging-domain-integrity.test.ts"
  },
  "dependencies": {
    "@voice-agent/contracts": "workspace:*",
    "@voice-agent/errors": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
